<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements of the signed app (hardened runtime). hame's desktop tool
  drives TextEdit, Numbers and Pages through their scripting (Apple
  events) from a helper the app starts; macOS attributes those events to
  the app, which therefore needs this entitlement to send them.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
