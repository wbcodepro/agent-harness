# hame-relay configuration (see docs/relay/DEPLOY.md for every variable).
# Secrets go in files under ./secrets and are passed as *_FILE variables
# in docker-compose.yml; do not put them here.

RELAY_PUBLIC_URL=https://relay.example.com
RELAY_APP_URL=https://app.example.com
RELAY_CORS_ORIGINS=https://app.example.com,tauri://localhost,http://tauri.localhost
RELAY_LOG=info

# Email
RELAY_MAILER=smtp
RELAY_SMTP_HOST=smtp.example.com
RELAY_SMTP_PORT=587
RELAY_SMTP_TLS=starttls
RELAY_SMTP_USERNAME=relay@example.com
RELAY_MAIL_FROM=hame <no-reply@example.com>

# Google sign-in (client secret in ./secrets/google_client_secret)
RELAY_GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# Apple sign-in (key in ./secrets/apple_key.p8)
RELAY_APPLE_CLIENT_ID=com.example.hame.signin
RELAY_APPLE_TEAM_ID=ABCDE12345
RELAY_APPLE_KEY_ID=KEY1234567

# Where OAuth may return to (web app page, desktop and mobile deep link)
RELAY_OAUTH_RETURN_URLS=https://app.example.com/oauth,hame://oauth

# Passkeys
RELAY_WEBAUTHN_RP_ID=example.com
RELAY_WEBAUTHN_RP_NAME=hame
RELAY_WEBAUTHN_ORIGINS=https://app.example.com

# Push (optional)
# RELAY_APNS_TOPIC=com.example.hame
# RELAY_APNS_TEAM_ID=ABCDE12345
# RELAY_APNS_KEY_ID=KEY7654321
# RELAY_APNS_PRIVATE_KEY_FILE=/run/secrets/apns_key
# RELAY_FCM_SERVICE_ACCOUNT_FILE=/run/secrets/fcm_service_account
